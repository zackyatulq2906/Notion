<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Notion AI Chat V58</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Bebas+Neue&display=swap');

  :root {
    --theme-color: #2e7ed5;
    --theme-rgb: 46, 126, 213;
    --bg-user: rgba(46, 126, 213, 0.2);
    --bg-ai: rgba(255, 255, 255, 0.05);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body, html {
    background-color: #1a1a1a;
    font-family: 'Plus Jakarta Sans', sans-serif;
    color: #ffffff;
    width: 100%; height: 100vh; overflow: hidden;
  }

  .container {
    width: 100%; height: 100%;
    padding: 15px;
    display: flex; justify-content: center; align-items: center;
  }

  /* --- KARTU UTAMA --- */
  .card {
    width: 100%; height: 100%; max-width: 500px;
    position: relative;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 25px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    display: flex; flex-direction: column;
    overflow: hidden;
    transition: border-color 0.3s;
  }
  
  .card:hover { border-color: rgba(var(--theme-rgb), 0.6); }

  /* --- HEADER --- */
  .header {
    padding: 15px 20px;
    background: rgba(0,0,0,0.2);
    border-bottom: 1px solid rgba(255,255,255,0.05);
    display: flex; justify-content: space-between; align-items: center;
  }
  
  .title-group { display: flex; align-items: center; gap: 10px; }
  .status-dot { width: 8px; height: 8px; background: #4cd964; border-radius: 50%; box-shadow: 0 0 10px #4cd964; }
  .title-text { font-family: 'Bebas Neue'; font-size: 24px; letter-spacing: 1px; color: var(--theme-color); }
  
  .btn-settings {
    background: transparent; border: none; color: rgba(255,255,255,0.3); 
    font-size: 18px; cursor: pointer; transition: 0.3s;
  }
  .btn-settings:hover { color: var(--theme-color); transform: rotate(90deg); }

  /* --- CHAT AREA --- */
  .chat-area {
    flex-grow: 1; overflow-y: auto; padding: 20px;
    display: flex; flex-direction: column; gap: 15px;
    scroll-behavior: smooth;
  }
  
  /* Scrollbar Custom */
  .chat-area::-webkit-scrollbar { width: 5px; }
  .chat-area::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }

  .message {
    max-width: 85%; padding: 10px 15px; border-radius: 15px;
    font-size: 13px; line-height: 1.5; position: relative;
    animation: fadeIn 0.3s ease;
  }
  
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

  .msg-ai {
    align-self: flex-start;
    background: var(--bg-ai);
    border-bottom-left-radius: 2px;
    border: 1px solid rgba(255,255,255,0.05);
  }
  
  .msg-user {
    align-self: flex-end;
    background: var(--bg-user);
    border-bottom-right-radius: 2px;
    color: white;
    border: 1px solid rgba(var(--theme-rgb), 0.3);
  }

  /* Markdown Styles (Simple) */
  .msg-ai strong { color: var(--theme-color); }
  .msg-ai code { background: rgba(0,0,0,0.3); padding: 2px 4px; border-radius: 4px; font-family: monospace; font-size: 12px; }

  /* --- INPUT AREA --- */
  .input-area {
    padding: 15px; background: rgba(0,0,0,0.2);
    border-top: 1px solid rgba(255,255,255,0.05);
    display: flex; gap: 10px; align-items: center;
  }
  
  .chat-input {
    flex-grow: 1; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
    color: white; padding: 12px; border-radius: 50px; font-family: 'Plus Jakarta Sans'; font-size: 13px;
    outline: none; transition: 0.3s;
  }
  .chat-input:focus { border-color: var(--theme-color); background: rgba(255,255,255,0.1); }
  
  .send-btn {
    width: 40px; height: 40px; border-radius: 50%;
    background: var(--theme-color); border: none; color: white;
    cursor: pointer; display: flex; justify-content: center; align-items: center;
    box-shadow: 0 0 15px rgba(var(--theme-rgb), 0.4); transition: 0.3s;
  }
  .send-btn:hover { transform: scale(1.1); box-shadow: 0 0 25px rgba(var(--theme-rgb), 0.6); }
  .send-btn:disabled { background: #555; cursor: not-allowed; box-shadow: none; }

  /* --- LOADING INDICATOR --- */
  .typing-indicator {
    align-self: flex-start; background: var(--bg-ai); padding: 10px 15px;
    border-radius: 15px; border-bottom-left-radius: 2px;
    display: none; gap: 5px;
  }
  .dot { width: 6px; height: 6px; background: rgba(255,255,255,0.4); border-radius: 50%; animation: bounce 1.4s infinite ease-in-out both; }
  .dot:nth-child(1) { animation-delay: -0.32s; }
  .dot:nth-child(2) { animation-delay: -0.16s; }
  @keyframes bounce { 0%, 80%, 100% { transform: scale(0); } 40% { transform: scale(1); } }

  /* --- SETTINGS PANEL --- */
  .settings-view {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background: #1a1a1a; z-index: 100;
    display: flex; flex-direction: column; 
    justify-content: center; align-items: center;
    padding: 30px; opacity: 0; pointer-events: none; transition: 0.3s;
  }
  .settings-view.show { opacity: 1; pointer-events: all; }

  .settings-title { font-family: 'Bebas Neue'; font-size: 32px; color: var(--theme-color); margin-bottom: 20px; }
  .input-group { width: 100%; margin-bottom: 15px; }
  .input-label { font-size: 11px; opacity: 0.7; margin-bottom: 5px; display: block; }
  .text-input { width: 100%; padding: 10px; background: #333; border: 1px solid #444; color: white; border-radius: 8px; }
  .save-btn { width: 100%; padding: 12px; background: var(--theme-color); color: white; border: none; border-radius: 8px; font-weight: 700; cursor: pointer; margin-top: 10px; }
  .link-api { font-size: 11px; color: var(--theme-color); text-decoration: none; margin-top: 15px; display: block; border-bottom: 1px solid; padding-bottom: 2px; }

</style>
</head>
<body>

  <div class="container">
    <div class="card">
      
      <div class="header">
        <div class="title-group">
          <div class="status-dot"></div>
          <div class="title-text">JAK ASSISTANT</div>
        </div>
        <button class="btn-settings" onclick="openSettings()">⚙</button>
      </div>

      <div class="chat-area" id="chatArea">
        <div class="message msg-ai">
          Halo Jak! 👋<br>Ada yang bisa aku bantu seputar kuliah atau project film hari ini?
        </div>
        
        <div class="typing-indicator" id="typingIndicator">
          <div class="dot"></div><div class="dot"></div><div class="dot"></div>
        </div>
      </div>

      <div class="input-area">
        <input type="text" class="chat-input" id="userInput" placeholder="Tanya sesuatu..." autocomplete="off">
        <button class="send-btn" id="sendBtn" onclick="sendMessage()">➤</button>
      </div>

      <div class="settings-view" id="settingsView">
        <div class="settings-title">SETUP GEMINI</div>
        
        <div class="input-group">
          <label class="input-label">GOOGLE GEMINI API KEY</label>
          <input type="password" id="inputApiKey" class="text-input" placeholder="Paste API Key disini...">
        </div>

        <div class="input-group">
          <label class="input-label">THEME COLOR</label>
          <input type="color" id="inputColor" class="text-input" style="height:40px; cursor:pointer;" value="#2e7ed5">
        </div>

        <button class="save-btn" onclick="saveSettings()">SAVE & CONNECT</button>
        <a href="https://aistudio.google.com/app/apikey" target="_blank" class="link-api">BELUM PUNYA API KEY? KLIK DISINI</a>
      </div>

    </div>
  </div>

  <script>
    /* --- LOGIC UTAMA --- */
    let apiKey = "";
    let themeColor = "#2e7ed5";

    // Load Data
    if(localStorage.getItem('geminiWidgetConfig')) {
      const config = JSON.parse(localStorage.getItem('geminiWidgetConfig'));
      apiKey = config.key;
      themeColor = config.color || "#2e7ed5";
      applyTheme(themeColor);
    } else {
      // Kalo belum ada key, paksa buka setting
      setTimeout(openSettings, 500);
    }

    const chatArea = document.getElementById('chatArea');
    const userInput = document.getElementById('userInput');
    const sendBtn = document.getElementById('sendBtn');
    const typingIndicator = document.getElementById('typingIndicator');
    const settingsView = document.getElementById('settingsView');

    function applyTheme(color) {
      document.documentElement.style.setProperty('--theme-color', color);
      
      // Hex to RGB
      let c; if(/^#([A-Fa-f0-9]{3}){1,2}$/.test(color)){ c= color.substring(1).split(''); if(c.length== 3){ c= [c[0], c[0], c[1], c[1], c[2], c[2]]; } c= '0x'+c.join(''); 
      const rgb = [(c>>16)&255, (c>>8)&255, c&255].join(',');
      document.documentElement.style.setProperty('--theme-rgb', rgb);
      }
    }

    function openSettings() { 
      document.getElementById('inputApiKey').value = apiKey;
      document.getElementById('inputColor').value = themeColor;
      settingsView.classList.add('show'); 
    }
    
    function saveSettings() {
      apiKey = document.getElementById('inputApiKey').value;
      themeColor = document.getElementById('inputColor').value;
      
      if(!apiKey) { alert("API Key wajib diisi bro!"); return; }
      
      localStorage.setItem('geminiWidgetConfig', JSON.stringify({ key: apiKey, color: themeColor }));
      applyTheme(themeColor);
      settingsView.classList.remove('show');
      
      // Kirim pesan sistem (opsional)
      addMessage("ai", "Sip! API Key tersimpan. Siap ngobrol!");
    }

    function addMessage(role, text) {
      // Hapus loading indicator dulu dari DOM (biar dia selalu paling bawah)
      chatArea.removeChild(typingIndicator);

      const msgDiv = document.createElement('div');
      msgDiv.className = `message msg-${role}`;
      // Simple format: ganti **text** jadi bold
      let formattedText = text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
      msgDiv.innerHTML = formattedText;
      
      chatArea.appendChild(msgDiv);
      // Balikin loading indicator ke paling bawah (tapi hidden)
      chatArea.appendChild(typingIndicator);
      
      // Auto scroll ke bawah
      chatArea.scrollTop = chatArea.scrollHeight;
    }

    async function sendMessage() {
      const text = userInput.value.trim();
      if (!text) return;
      if (!apiKey) { alert("Setting dulu API Key-nya, klik tombol Gear ⚙️"); return; }

      // 1. Tampilin Chat User
      addMessage("user", text);
      userInput.value = "";
      userInput.focus();

      // 2. Munculin Loading
      typingIndicator.style.display = "flex";
      chatArea.scrollTop = chatArea.scrollHeight;
      sendBtn.disabled = true;

      try {
        // 3. Panggil API Gemini
        const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${apiKey}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            contents: [{ parts: [{ text: text }] }]
          })
        });

        const data = await response.json();
        
        // 4. Sembunyiin Loading
        typingIndicator.style.display = "none";
        sendBtn.disabled = false;

        if (data.candidates && data.candidates[0].content) {
          const reply = data.candidates[0].content.parts[0].text;
          addMessage("ai", reply);
        } else {
          addMessage("ai", "Waduh, error nih. Cek API Key kamu bener gak?");
        }

      } catch (error) {
        typingIndicator.style.display = "none";
        sendBtn.disabled = false;
        addMessage("ai", "Koneksi gagal bro. Cek internet atau API Key.");
        console.error(error);
      }
    }

    // Enter buat kirim
    userInput.addEventListener("keypress", function(event) {
      if (event.key === "Enter") sendMessage();
    });

  </script>

</body>
</html>
